+*.cpp
c++ 17
require Soup/soup
arg -O3

## Require DTLS and refuse service for too new versions
arg -DDEPLOYMENT=false

## Bind to the LAN IP of the first physical network adaptor
arg -DIS_LAN_DEPLOYMENT=true

## Uncomment to enable DTLS support
# arg -DUSE_DTLSBRIDGE=true
# linker_arg -L.
# linker_arg -lDTLSBridge

## Uncomment for multiple binding servers
# arg -DMULTI_NRS=true
# arg -DSERVERS={"10.0.0.0:1234","nrs2.local"}
# arg -DTHIS_SERVER_ID=0
